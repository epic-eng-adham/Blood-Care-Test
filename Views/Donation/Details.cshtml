@model BloodCareF.Models.Donation

@{
    ViewData["Title"] = "Donation Details";
}



<div class="container mt-5">


    <div class="row justify-content-center">


        <div class="col-md-6">


            <div class="card shadow border-0">


                <div class="card-header bg-danger text-white text-center">


                    <h3>
                        🩸 Donation Details
                    </h3>


                </div>





                <div class="card-body text-center">


                    <h2 class="fw-bold">
                        Donation #@Model.Id
                    </h2>


                    <hr />



                    <div class="text-start mt-4">


                        <p>

                            <strong>
                                Donor:
                            </strong>

                            @Model.Donor.FullName

                        </p>




                        <p>

                            <strong>
                                Patient:
                            </strong>

                            @Model.Patient.FullName

                        </p>





                        <p>

                            <strong>
                                Quantity:
                            </strong>

                            @Model.Quantity

                        </p>





                        <p>

                            <strong>
                                Donation Date:
                            </strong>

                            @Model.DonationDate.ToString("yyyy-MM-dd")

                        </p>



                    </div>





                    <div class="mt-4">


                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-warning">

                            Edit

                        </a>



                        <a asp-action="ShowDonation"
                           class="btn btn-secondary ms-2">

                            Back

                        </a>


                    </div>


                </div>


            </div>


        </div>


    </div>


</div>