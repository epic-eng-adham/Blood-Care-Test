@model BloodCareF.Models.Donation

@{
    ViewData["Title"] = "Add Donation";
}


<div class="container mt-5">


    <div class="row justify-content-center">


        <div class="col-md-7">


            <div class="card shadow border-0">


                <div class="card-header bg-danger text-white text-center">

                    <h3>
                        🩸 Add Donation
                    </h3>

                </div>




                <div class="card-body">


                    <form asp-action="Add" method="post">


                        <div class="mb-3">


                            <label class="form-label fw-bold">
                                Donor
                            </label>


                            <select asp-for="DonorId"
                                    class="form-select">


                                <option value="">
                                    -- Select Donor --
                                </option>


                                @foreach (var item in ViewBag.Donor)
                                {

                                    <option value="@item.ID">

                                        @item.FullName

                                    </option>

                                }


                            </select>


                        </div>





                        <div class="mb-3">


                            <label class="form-label fw-bold">
                                Patient
                            </label>


                            <select asp-for="PAtientId"
                                    class="form-select">


                                <option value="">
                                    -- Select Patient --
                                </option>


                                @foreach (var item in ViewBag.Patient)
                                {

                                    <option value="@item.Id">

                                        @item.FullName

                                    </option>

                                }


                            </select>


                        </div>






                        <div class="mb-3">


                            <label class="form-label fw-bold">
                                Quantity
                            </label>


                            <input asp-for="Quantity"
                                   class="form-control" />


                        </div>






                        <div class="mb-3">


                            <label class="form-label fw-bold">
                                Donation Date
                            </label>


                            <input asp-for="DonationDate"
                                   type="date"
                                   class="form-control" />


                        </div>







                        <div class="text-center">


                            <button type="submit"
                                    class="btn btn-success px-5">

                                Save

                            </button>




                            <a asp-action="ShowDonation"
                               class="btn btn-secondary ms-2">

                                Back

                            </a>


                        </div>



                    </form>


                </div>


            </div>


        </div>


    </div>


</div>