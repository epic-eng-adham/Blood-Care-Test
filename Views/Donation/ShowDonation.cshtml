@model List<BloodCareF.Models.Donation>
@{
    ViewData["Title"] = "Donations";
}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            💉 Donations
        </h2>
        <a asp-controller="Donation"
           asp-action="Add"
           class="btn btn-success">
            ➕ Add Donation
        </a>
    </div>
    <div class="card shadow border-0">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-warning text-center">
                    <tr>
                        <th>
                            ID
                        </th>
                        <th>
                            Donor
                        </th>
                        <th>
                            Patient
                        </th>
                        <th>
                            Quantity
                        </th>
                        <th>
                            Date
                        </th>
                        <th>
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="text-center">
                            <td>
                                @item.Id
                            </td>
                            <td>
                                @item.Donor.FullName
                            </td>
                            <td>
                                @item.Patient.FullName
                            </td>
                            <td>
                                <span class="badge bg-danger">
                                    @item.Quantity
                                </span>
                            </td>
                            <td>

                                @item.DonationDate.ToString("yyyy-MM-dd")
                            </td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm text-white">
                                    Details
                                </a>
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>
                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Delete this donation?');">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>


    </div>
    <div class="text-center mt-5 mb-4">
        <a asp-controller="Home"
           asp-action="Index"
           class="home-btn">

            🏠 Back To Home
        </a>
    </div>
</div>
<style>
    .home-btn {
        display: inline-block;
        padding: 12px 35px;
        background: linear-gradient(135deg,#991b1b,#dc2626);
        color: white;
        text-decoration: none;
        font-size: 18px;
        font-weight: 700;
        border-radius: 30px;
        box-shadow: 0 10px 25px rgba(220,38,38,.3);
        transition: .3s;
    }
        .home-btn:hover {
            transform: translateY(-5px);
            color: white;
        }
</style>