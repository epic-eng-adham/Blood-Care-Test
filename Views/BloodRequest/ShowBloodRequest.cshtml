@model List<BloodCareF.Models.BloodRequest>

@{
    ViewData["Title"] = "Blood Requests";
}


<div class="container mt-5">


    <div class="d-flex justify-content-between align-items-center mb-4">


        <h2 class="fw-bold">
            🩸 Blood Requests
        </h2>


        <a asp-controller="BloodRequest"
           asp-action="Add"
           class="btn btn-success">

            ➕ Add Request

        </a>


    </div>





    <div class="card shadow border-0">


        <div class="card-body">


            <table class="table table-hover align-middle">


                <thead class="table-danger text-center">

                    <tr>

                        <th>
                            ID
                        </th>


                        <th>
                            Patient
                        </th>


                        <th>
                            Blood Type
                        </th>


                        <th>
                            Quantity
                        </th>


                        <th>
                            Request Date
                        </th>


                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>




                <tbody>


                    @foreach (var item in Model)
                    {

                        <tr class="text-center">


                            <td>
                                @item.Id
                            </td>



                            <td>
                                @item.Patient.FullName
                            </td>




                            <td>

                                <span class="badge bg-danger fs-6">

                                    @item.BloodType.TypeName

                                </span>

                            </td>





                            <td>
                                @item.QuantityNeeded
                            </td>





                            <td>
                                @item.RequestDate.ToString("yyyy-MM-dd")
                            </td>





                            <td>


                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm text-white">

                                    Details

                                </a>




                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    Edit

                                </a>




                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to delete this request?');">

                                    Delete

                                </a>


                            </td>


                        </tr>

                    }


                </tbody>


            </table>


        </div>


    </div>
    <div class="text-center mt-5 mb-4">

        <a asp-controller="Home"
           asp-action="Index"
           class="home-btn">

            🏠 Back To Home

        </a>

    </div>


</div>
<style>
    .home-btn {
        display: inline-block;
        padding: 12px 35px;
        background: linear-gradient(135deg,#991b1b,#dc2626);
        color: white;
        text-decoration: none;
        font-size: 18px;
        font-weight: 700;
        border-radius: 30px;
        box-shadow: 0 10px 25px rgba(220,38,38,.3);
        transition: .3s;
    }



        .home-btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(220,38,38,.45);
            color: white;
        }
</style>