@model BloodCareF.Models.BloodRequest

@{
    ViewData["Title"] = "Add Blood Request";
}


<div class="container mt-5">


    <div class="row justify-content-center">


        <div class="col-md-7">


            <div class="card shadow border-0">


                <div class="card-header bg-danger text-white text-center">

                    <h3>
                        🩸 Add Blood Request
                    </h3>

                </div>



                <div class="card-body">


                    <form asp-action="Add" method="post">


                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Patient
                            </label>


                            <select asp-for="PatientId"
                                    class="form-select">


                                <option value="">
                                    -- Select Patient --
                                </option>


                                @foreach (var item in ViewBag.Patient)
                                {

                                    <option value="@item.Id">

                                        @item.FullName

                                    </option>

                                }


                            </select>


                        </div>





                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Blood Type
                            </label>


                            <select asp-for="BloodTypeId"
                                    class="form-select">


                                <option value="">
                                    -- Select Blood Type --
                                </option>


                                @foreach (var item in ViewBag.BloodType)
                                {

                                    <option value="@item.Id">

                                        @item.TypeName

                                    </option>

                                }


                            </select>


                        </div>






                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Quantity Needed
                            </label>


                            <input asp-for="QuantityNeeded"
                                   class="form-control" />


                        </div>






                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Request Date
                            </label>


                            <input asp-for="RequestDate"
                                   type="date"
                                   class="form-control" />


                        </div>







                        <div class="text-center">


                            <button type="submit"
                                    class="btn btn-success px-5">

                                Save

                            </button>




                            <a asp-action="ShowBloodRequest"
                               class="btn btn-secondary ms-2">

                                Back

                            </a>


                        </div>



                    </form>


                </div>


            </div>


        </div>


    </div>


</div>