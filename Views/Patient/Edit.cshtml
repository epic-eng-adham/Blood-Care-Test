@model BloodCareF.Models.Patient

@{
    ViewData["Title"] = "Edit Patient";
}


<div class="container mt-5">


    <div class="row justify-content-center">


        <div class="col-md-8">


            <div class="card shadow border-0">


                <div class="card-header bg-warning text-center">

                    <h3>
                        ✏️ Edit Patient
                    </h3>

                </div>



                <div class="card-body">


                    <form asp-action="Edit" method="post">


                        <input type="hidden" asp-for="Id" />



                        <div class="row">


                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-bold">
                                    Full Name
                                </label>


                                <input asp-for="FullName"
                                       class="form-control" />


                            </div>




                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-bold">
                                    Age
                                </label>


                                <input asp-for="Age"
                                       class="form-control" />


                            </div>


                        </div>






                        <div class="row">


                            <div class="col-md-6 mb-3">


                                <label class="form-label fw-bold">
                                    Blood Type
                                </label>



                                <select asp-for="BloodTypeID"
                                        class="form-select">


                                    @foreach (var item in ViewBag.BloodType)
                                    {

                                        if (item.Id == Model.BloodTypeID)
                                        {
                                            <option value="@item.Id" selected>
                                                @item.TypeName
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@item.Id">
                                                @item.TypeName
                                            </option>
                                        }

                                    }


                                </select>


                            </div>





                            <div class="col-md-6 mb-3">


                                <label class="form-label fw-bold">
                                    Gender
                                </label>


                                <select asp-for="Gender"
                                        class="form-select">


                                    <option value="Male">
                                        Male
                                    </option>


                                    <option value="Female">
                                        Female
                                    </option>


                                </select>


                            </div>


                        </div>







                        <div class="mb-3">


                            <label class="form-label fw-bold">
                                Phone
                            </label>


                            <input asp-for="Phone"
                                   class="form-control" />


                        </div>






                        <div class="mb-3">


                            <label class="form-label fw-bold">
                                Address
                            </label>


                            <textarea asp-for="Address"
                                      class="form-control"></textarea>


                        </div>







                        <div class="text-center mt-4">


                            <button type="submit"
                                    class="btn btn-warning px-5">

                                Save Changes

                            </button>




                            <a asp-action="ShowPatient"
                               class="btn btn-secondary ms-2">

                                Back

                            </a>


                        </div>



                    </form>


                </div>


            </div>


        </div>


    </div>


</div>